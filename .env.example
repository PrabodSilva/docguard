# ------------------------------------------------------------------
# DocGuard settings. On first run the app copies this file to .env
# and fills in DATA_KEY and SESSION_SECRET with random secrets.
# NEVER share your .env file. If you lose DATA_KEY, the
# encrypted document details in the database can't be recovered.
# ------------------------------------------------------------------

PORT=3000
DB_FILE=data/docguard.db

# 32-byte AES-256 key (base64) used to encrypt document details
DATA_KEY=
# Secret used to sign login sessions
SESSION_SECRET=
SESSION_DAYS=7

# Set to true when served over HTTPS (e.g. after putting it online)
SECURE_COOKIES=false
# Open the browser automatically when the server starts
OPEN_BROWSER=true

# Country code added to local numbers like 0771234567 (94 = Sri Lanka, 91 = India)
DEFAULT_COUNTRY_CODE=94

# SMS reminders are only sent between these hours
REMINDER_HOUR_START=8
REMINDER_HOUR_END=20

# SMS provider: console | notifylk | twilio
#   console  = no real SMS, messages are printed in the terminal (for testing)
#   notifylk = Notify.lk (Sri Lankan SMS gateway)  https://notify.lk
#   twilio   = Twilio (works worldwide)            https://twilio.com
SMS_PROVIDER=console

NOTIFYLK_USER_ID=
NOTIFYLK_API_KEY=
NOTIFYLK_SENDER_ID=NotifyDEMO

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=